# ===== 必須 =====
# ローカルのテスト用DB（npm run db:local）。本番は Vercel の Neon 連携で自動設定される
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@127.0.0.1:5434/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
APP_URL="http://localhost:5173"

# ===== Googleマップ（地図・実在のお店の検索）=====
# Google Cloud で Maps JavaScript API と Places API (New) を有効にしたブラウザ用キー（HTTPリファラーで制限する）
GOOGLE_MAPS_API_KEY=""
# 地図のスタイルID（なければ DEMO_MAP_ID）
GOOGLE_MAP_ID=""

# ===== パスワード再設定メール（Resend）=====
RESEND_API_KEY=""
EMAIL_FROM="Tabi Local <onboarding@resend.dev>"

# ===== 翻訳 =====
# GEMINI_API_KEY があれば Gemini（AI翻訳）を使う。失敗したら無料の機械翻訳（MyMemory）に切り替わる
# キーは https://aistudio.google.com/apikey で発行し、Vercel の Settings → Environment Variables に登録する
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# 空なら自動（Gemini のキーがあれば gemini、なければ mymemory）。gemini | mymemory | claude
TRANSLATION_PROVIDER="
MYMEMORY_EMAIL=""
ANTHROPIC_API_KEY=""
